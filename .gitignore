# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Editor backup copies (e.g. foo.py.bak_before_yerr) — scratch snapshots
# taken before a risky edit, never meant to be versioned
*.bak
*.bak_*

# Jupyter
.ipynb_checkpoints/

# Generated outputs (PDF/CSV from running the scripts on your own data) —
# these are run-specific results, not meant to be versioned. The example
# figure under examples/ is explicitly kept (see negation rule below).
*.pdf
*.csv
!examples/*.pdf

# OS / editor
.DS_Store
.vscode/
